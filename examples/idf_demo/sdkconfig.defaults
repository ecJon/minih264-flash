# Baseline: runs WITHOUT PSRAM (demo defaults are 160x120, which fits the
# ~380 KiB internal heap of an ESP32-S3).
#
# Board note: the board this example was validated on is marked ESP32-S3
# N16R8 (16 MB flash detected correctly), but its PSRAM does not respond in
# either OCTAL or QUAD mode, at 40 or 80 MHz (chip revision v0.2) - likely
# no/faulty PSRAM on the module. On a healthy N16R8 board you can raise the
# resolution in demo_defaults() (demo/minih264_demo.c) and add:
#   CONFIG_SPIRAM=y
#   CONFIG_SPIRAM_MODE_OCTAL=y
#   CONFIG_SPIRAM_SPEED_80M=y
#   CONFIG_SPIRAM_USE_MALLOC=y
#   CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_FREERTOS_HZ=1000
